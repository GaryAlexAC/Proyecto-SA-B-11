generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Este modelo es un ejemplo para el Notification & Audit Service
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  service   String
  details   String?
  createdAt DateTime @default(now())
}
