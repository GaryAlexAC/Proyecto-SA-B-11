generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-transaction"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String            @id @default(uuid())
  correlationId   String            @unique
  customerId      String
  initiatedBy     String
  initiatorRole   String
  idempotencyKey  String?           @unique
  operation       String            @default("TRANSFER")
  requestHash     String            @default("")
  sourceAccountId String
  targetAccountId String?
  companyId       String?
  amount          Decimal           @db.Decimal(15, 2)
  status          TransactionStatus @default(PENDING)
  failReason      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  processedEvents ProcessedEvent[]
}

model ProcessedEvent {
  id            String      @id @default(uuid())
  eventId       String      @unique
  processedAt   DateTime    @default(now())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model OutboxEvent {
  id            String   @id
  eventType     String
  eventVersion  Int      @default(1)
  occurredAt    DateTime @default(now())
  correlationId String
  causationId   String?
  producer      String   @default("transaction-service")
  payload       Json
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  publishedAt   DateTime?
  failedAt      DateTime?
  lastError     String?

  @@index([publishedAt, failedAt, nextAttemptAt])
}

enum TransactionStatus {
  PENDING_KYC
  PENDING
  PROCESSING
  APPROVED
  FAILED
  COMPENSATING
}
