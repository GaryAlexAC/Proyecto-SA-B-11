generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-payment"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  correlationId String        @unique
  idempotencyKey String?       @unique
  requestHash    String?
  customerId     String?
  initiatedBy    String?
  sourceAccountId String?
  serviceId      String?
  amount        Decimal       @db.Decimal(15, 2)
  status        PaymentStatus @default(PENDING)
  type          PaymentType   @default(INTERNAL)
  description   String?
  failReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  processedEvents ProcessedEvent[]
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

model Service {
  id        String   @id @default(uuid())
  companyId String
  name      String
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  processedAt DateTime @default(now())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
}

enum PaymentType {
  INTERNAL
  EXTERNAL
}

enum InterbankDirection {
  INCOMING
  OUTGOING
}

enum InterbankStatus {
  PENDING
  SENT
  PROCESSING
  ACCEPTED
  REJECTED
  CANCELLED
  TIMEOUT
  REVERSED
}

model InterbankTransfer {
  id                  String             @id @default(uuid())
  interbankTransferId String             @unique
  direction           InterbankDirection
  originBankCode      String
  destinationBankCode String
  originAccount       String
  destinationAccount  String
  amount              Decimal            @db.Decimal(15, 2)
  currency            String             @default("GTQ")
  description         String?
  status              InterbankStatus    @default(PROCESSING)
  reasonCode          String?
  reasonMessage       String?
  requestHash         String             @default("")
  idempotencyKey      String             @unique
  traceparent         String?
  correlationId       String?
  createdAt           DateTime           @default(now())
  expiresAt           DateTime
  updatedAt           DateTime           @updatedAt
  processedAt         DateTime?
  callbackUrl         String?
  callbackAttempts    Int                @default(0)
  callbackDeliveredAt DateTime?
}

model InterbankReversal {
  id                 String   @id @default(uuid())
  reversalId         String   @unique
  originalTransferId String
  reason             String
  status             String   @default("PROCESSING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
